{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeDeck companion error",
  "description": "Body of every non-2xx response. Clients MUST ignore unknown properties (additive changes do not bump schema_version).",
  "type": "object",
  "$id": "https://forgedeck.invalid/companion/v1/error.schema.json",
  "required": [
    "schema_version",
    "error"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "_example_notice": {
      "type": "string",
      "description": "Present only in the files under examples/. Never sent by a real companion."
    }
  }
}
